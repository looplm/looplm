# ─────────────────────────────────────────────────────────────────────────────
# Generate every secret in this block BEFORE the first boot:   make secrets
# The API refuses to start while API_SECRET_KEY is unset or the shipped default.
# ─────────────────────────────────────────────────────────────────────────────

# Database - POSTGRES_PASSWORD is required; docker compose fails fast without it.
POSTGRES_USER=looplm
POSTGRES_PASSWORD=
POSTGRES_DB=looplm
DATABASE_URL=postgresql+asyncpg://looplm:CHANGE_ME@localhost:5432/looplm

# Redis - required; the compose redis runs with --requirepass.
REDIS_PASSWORD=
REDIS_URL=redis://:CHANGE_ME@localhost:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=
DEBUG=false

# Secret the stored-credential encryption key is derived from. Leave empty to derive it from
# API_SECRET_KEY (the historical behaviour). When you REPLACE an existing API_SECRET_KEY, set
# this to the old value or every stored integration credential becomes undecryptable.
ENCRYPTION_SECRET=

# Serve /docs, /redoc and /openapi.json. Off by default - the schema maps every route.
DOCS_ENABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3100

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_REPOSITORY_URL=

# LLM (for analysis engine)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANALYSIS_LLM_PROVIDER=openai
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=

# Cohere Rerank — cross-encoder reranking head, scored as its own stage on the Retrieval page.
# Endpoint is an Azure AI Foundry serverless Cohere deployment
# (https://<name>.<region>.models.ai.azure.com) or https://api.cohere.com for Cohere's own API;
# "/v2/rerank" is appended unless the URL already names a route. Per-project settings override
# these. Leave the endpoint or key empty to disable the Cohere stages.
COHERE_RERANK_ENDPOINT=
COHERE_RERANK_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5

# Query embeddings — which backend embeds queries for vector/hybrid retrieval. Empty follows
# ANALYSIS_LLM_PROVIDER (with AZURE_OPENAI_EMBEDDING_DEPLOYMENT / OPENAI_EMBEDDING_MODEL); set it
# to "cohere" when the index's vectors were built by a Cohere model. This must match the model
# that built the index: a vector of the right length from the wrong model is accepted by the
# search backend and scored against the wrong space, silently. Per-project settings override these.
EMBEDDING_PROVIDER=
COHERE_EMBED_ENDPOINT=
COHERE_EMBED_API_KEY=
COHERE_EMBED_MODEL=embed-v-4-0

# Evaluations
EVAL_TARGET_ENDPOINT=
EVAL_DEFAULT_CONCURRENCY=2

# Auto-grading
AUTO_GRADE_ENABLED=false
AUTO_GRADE_INTERVAL_MINUTES=5
AUTO_GRADE_BATCH_SIZE=20
AUTO_GRADE_MIN_OUTPUT_LENGTH=50

# Update check — looks up the latest GitHub release for the About settings panel.
# Set to false for air-gapped deployments. GITHUB_TOKEN is optional and only
# raises GitHub's anonymous rate limit (60/h per IP).
UPDATE_CHECK_ENABLED=true
GITHUB_TOKEN=

# Platform admin — the email below is treated as platform admin even if the
# users row hasn't been promoted yet. The first registered user is also
# auto-promoted; this var is mainly for recovery and pre-existing deploys.
INSTANCE_OWNER_EMAIL=

# GitHub App — enables the Code Agent to clone connected repos via browser auth.
# Leave GITHUB_APP_ID empty to disable the feature entirely.
# Register an App at github.com/settings/apps. Required permissions:
#   Repository → Contents: Read, Metadata: Read.
# The callback URL on the App settings page must be:
#   <your-frontend-origin>/github/callback
GITHUB_APP_ID=
GITHUB_APP_NAME=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Pass the PEM contents (escape newlines as \n) OR set GITHUB_APP_PRIVATE_KEY_PATH.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
# Where project repos are cloned. Supports ~ and $VARS.
# Local dev: use a writable home path, e.g. ~/.looplm/repos
GITHUB_CLONE_DIR=/var/looplm/repos

# First-party tracing ingest (push-based SDK → /api/v1/ingest)
INGEST_ENABLED=true
INGEST_MAX_BATCH=100
INGEST_MAX_SPANS_PER_TRACE=1000

# Connectors
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGSMITH_API_KEY=
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=
